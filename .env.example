# Copy this file to .env.local and fill in your real values before running the app.

# MongoDB connection string (local MongoDB or MongoDB Atlas)
# If DNS blocks mongodb+srv:// SRV lookups on your network, use the standard mongodb:// connection string from Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/yatrabus

# Secret key for signing HTTP-only JWT session cookies.
# REQUIRED in production and must be at least 32 characters long.
JWT_SECRET=replace-with-a-secure-32-char-random-secret-key

# Google Gemini API key for Vercel AI SDK (@ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key

# Optional: override the default Gemini Flash model (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
