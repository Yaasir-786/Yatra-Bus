# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/yatrabus

# Secret key for signing HTTP-only JWT session cookies (use at least 32 random characters in production)
JWT_SECRET=replace-with-a-secure-32-char-random-secret-key

# Google Gemini API key for Vercel AI SDK (@ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key
